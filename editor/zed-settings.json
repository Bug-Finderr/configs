// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "cli_default_open_behavior": "existing_window",
  "git_panel": {
    "group_by": "staging",
    "tree_view": false
  },
  "preview_tabs": {
    "enable_keep_preview_on_code_navigation": false
  },
  "buffer_font_weight": 400.0,
  "scrollbar": {
    "git_diff": true
  },
  "edit_predictions": {
    "provider": "copilot"
  },
  "agent": {
    "thinking_display": "preview",
    "show_turn_stats": true,
    "play_sound_when_agent_done": "always",
    "tool_permissions": {
      "default": "allow",
      "tools": {
        "terminal": {
          "default": "allow"
        }
      }
    },
    "default_model": {
      "provider": "anthropic",
      "model": "claude-opus-5",
      "enable_thinking": true,
      "effort": "high"
    },
    "sidebar_side": "right",
    "favorite_models": [],
    "model_parameters": []
  },
  "project_panel": {
    "dock": "left"
  },
  "telemetry": {
    "diagnostics": true,
    "metrics": true,
    "anthropic_retention": false
  },
  "session": {
    "trust_all_worktrees": true
  },
  "terminal": {
    "show_count_badge": false,
    "toolbar": {
      "breadcrumbs": false
    },
    "env": {},
    "font_family": "FiraCode Nerd Font",
    "font_fallbacks": [
      "Consolas",
      "Courier New"
    ],
    "cursor_shape": "bar",
    "blinking": "on"
  },
  "base_keymap": "VSCode",
  "minimap": {
    "show": "never"
  },
  "buffer_font_fallbacks": [
    "FiraCode Nerd Font Mono",
    "Consolas",
    "Courier New"
  ],
  "buffer_font_family": "Fira Code iScript",
  "buffer_font_features": {
    "calt": true
  },
  "experimental.theme_overrides": {
    "syntax": {
      "comment": {
        "font_style": "italic"
      },
      "comment.doc": {
        "font_style": "italic"
      },
      "keyword": {
        "font_style": "italic"
      },
      "attribute": {
        "font_style": "italic"
      },
      "type": {
        "font_weight": 700
      },
      "constructor": {
        "font_weight": 700
      },
      "title": {
        "font_style": "italic",
        "font_weight": 700
      }
    }
  },
  "auto_indent_on_paste": true,
  "linked_edits": true,
  "format_on_save": "on",
  "soft_wrap": "editor_width",
  "agent_servers": {
    "claude-acp": {
      "type": "registry"
    },
    "codex-acp": {
      "type": "registry"
    }
  },
  "icon_theme": {
    "mode": "system",
    "light": "Zed (Default)",
    "dark": "Material Icon Theme"
  },
  "ui_font_size": 16,
  "buffer_font_size": 13.0,
  "theme": {
    "mode": "system",
    "light": "Ayu Light",
    "dark": "GitHub Dark",
  },
}
