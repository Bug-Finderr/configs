{
  "cleanupPeriodDays": 99999,
  "env": {
    "NODE_OPTIONS": "--no-experimental-webstorage"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "model": "opus",
  "hooks": {
    "Notification": [
      {
        "matcher": "permission_prompt|idle_prompt|agent_needs_input",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe",
            "args": [
              "-NoProfile",
              "-NonInteractive",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              "D:/Files/Dev/configs/windows/claude/notify.ps1"
            ],
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe",
            "args": [
              "-NoProfile",
              "-NonInteractive",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              "D:/Files/Dev/configs/windows/claude/notify.ps1"
            ],
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe",
            "args": [
              "-NoProfile",
              "-NonInteractive",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              "D:/Files/Dev/configs/windows/claude/notify.ps1"
            ],
            "timeout": 10,
            "async": true
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "fresh"
  },
  "statusLine": {
    "type": "command",
    "command": "powershell -NoProfile -ExecutionPolicy Bypass -File D:/Files/Dev/configs/windows/claude/statusline.ps1",
    "padding": 0
  },
  "subagentStatusLine": {
    "type": "command",
    "command": "powershell -NoProfile -ExecutionPolicy Bypass -File D:/Files/Dev/configs/windows/claude/statusline.ps1"
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "cc-plugin-you-should-know@builtin": true,
    "typescript-native-lsp@anthropic-plugin-directory": true,
    "context7@anthropic-plugin-directory": true
  },
  "extraKnownMarketplaces": {},
  "feedbackDrafts": "off",
  "effortLevel": "high",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "high"
    }
  },
  "ultracode": true,
  "advisorModel": "opus",
  "pluginConfigs": {
    "agents-md@builtin": {
      "options": {
        "instructionFiles": "claude-md-or-agents-md"
      }
    },
    "cc-plugin-agents-md@builtin": {
      "options": {
        "instructionFiles": "claude-md-and-agents-md"
      }
    }
  },
  "autoUpdatesChannel": "latest",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "timeFormat": "24-hour",
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "theme": "dark",
  "editorMode": "normal",
  "preferredNotifChannel": "auto",
  "autoCompactEnabled": true,
  "idleCompaction": true,
  "switchModelsOnFlag": true,
  "fileCheckpointingEnabled": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "voiceEnabled": true
}
