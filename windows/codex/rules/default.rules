prefix_rule(pattern=["Select-Object", "-ExpandProperty", "Name"], decision="allow")
prefix_rule(pattern=["Measure-Object"], decision="allow")
prefix_rule(pattern=["Get-Content", "-Path"], decision="allow")
prefix_rule(pattern=["curl.exe", "-L"], decision="allow")
prefix_rule(pattern=["docker", "--version"], decision="allow")
prefix_rule(pattern=["Get-ChildItem", "-Path"], decision="allow")
prefix_rule(pattern=["git", "status"], decision="allow")
prefix_rule(pattern=["New-Item", "-ItemType", "Directory"], decision="allow")
prefix_rule(pattern=["Select-String", "-Path"], decision="allow")
prefix_rule(pattern=["pnpm", "typecheck"], decision="allow")
